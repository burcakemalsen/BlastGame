<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the Unity Core sources in place (no copies). Pinned to what Unity 6000.6.3f1 uses:
       C# 9.0, netstandard2.1 (see reports/00-setup.md). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Core</AssemblyName>
    <RootNamespace>BlastGame.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
  </ItemGroup>

</Project>
